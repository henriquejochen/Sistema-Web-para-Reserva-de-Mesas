DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-grande
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Para PostgreSQL, descomente e configure:
# POSTGRES_DB=reservas
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=senha
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Políticas da reserva (enviadas ao frontend em /api/configuration/):
RESERVA_CHEGADA_MINIMA=19:30
RESERVA_CHEGADA_MAXIMA=21:30
RESERVA_MAX_PESSOAS=12
RESERVA_ALERTA_MINUTOS=15
RESERVA_TOLERANCIA_MINUTOS=30
# Telefone real da pizzaria (vazio = não exibe):
RESERVA_TELEFONE_CONTATO=
# Limite de requisições por IP de visitantes:
LIMITE_RESERVAS=60/hour
LIMITE_LOGIN=10/minute
